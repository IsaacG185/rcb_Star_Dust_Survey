#!/bin/csh
#
#  NOTE: THIS FILE IS OBSOLETE
#
#  Nov  6, 2007 Edward J. Los - Remove directory references and use environment variables instead
#  Nov  7, 2007 Edward J. Los - Remove perl scripts and replace with prepare_mosaic and save_results
#  Mar 10, 2008 Edward J. Los - Remove save_results
#  Jul 16, 2008 Edward J. Los - Use catrms=0.02 for webda, sdss, and KeplerCam
#  Jan 13, 2009 Edward J. Los - Add colorterm.m  
#
#  NOTE: THIS FILE IS OBSOLETE
#  
#  Note: use catrms=0.22 for gsc catalog
set imagelist = $1
cd $DASCH_SCRIPTS
echo "directory: ${DASCH_SCRIPTS} imagelist: ${imagelist}"
date
#$DASCH_SCRIPTS/find_astrometry.csh $imagelist
#cd $DASCH_SCRIPTS
#$DASCH_SCRIPTS/find_multiple.csh $imagelist
set iteration = 3;
#################################################
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/prepare_mosaic.csh $imagelist
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/run_sextractor.csh $imagelist 
while ($iteration > 0)
  echo "ccmap iteration: $iteration"
  cd $DASCH_SCRIPTS
  $DASCH_SCRIPTS/run_match.csh $imagelist 
  cd $DASCH_SCRIPTS 
  $DASCH_SCRIPTS/refine_wcs.csh $imagelist
  cd $DASCH_SCRIPTS
  $DASCH_SCRIPTS/run_sextractor_second.csh $imagelist 
  cd $DASCH_SCRIPTS
  @ iteration = $iteration - 1
  if ($iteration > 0) then
    $DASCH_SCRIPTS/refine_iteration.csh $imagelist
  endif
end
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/filter_wedge.csh $imagelist
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/run_match_second.csh $imagelist
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/filter_defect.csh $imagelist
####################### END OF VERSION INDEPENDENT CODE ###############
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/prepare_octave.csh $imagelist 
cd $DASCH_SCRIPTS
octave divide_annul9.m $imagelist 
cd $DASCH_SCRIPTS
octave colorterm.m $imagelist 
cd $DASCH_SCRIPTS
octave annular9.m $imagelist 
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/ingest_matlab2.csh $imagelist
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/run_local_calibration.csh $imagelist
cd $DASCH_SCRIPTS
$DASCH_SCRIPTS/recover_points.csh $imagelist catrms=0.22 
